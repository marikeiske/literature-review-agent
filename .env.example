# Copie este arquivo para .env e preencha. Nunca compartilhe nem versione o .env.

# Provedor usado ao iniciar: ollama | groq | openrouter
PROVEDOR=ollama

# Ollama (sem chave): contêiner ollama-novo. Modelos de nuvem (ex.: gemma4:31b-cloud)
# exigem conta gratuita conectada com: docker exec -it ollama-novo ollama signin
OLLAMA_BASE_URL=http://localhost:11435/v1
OLLAMA_MODEL=bonsai-2:4b

# Groq (plano gratuito): crie a chave em console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (plano gratuito do Google AI Studio): crie a chave em aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter (modelos terminados em :free): mesma variável das demos da disciplina
OPENROUTER_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Ajustes do harness
MAX_CICLOS=12
MAX_TOOLS=4
TOP_K=5
TAMANHO_TRECHO=900

# Acesso pelo celular via Tailscale (opcional; passo a passo no README.pt-BR.md)
# MESA_REMOTO=1
# MESA_CODIGO=   (deixe vazio: a interface cria um código forte na primeira vez)
